{
  "version": 2,
  "builds": [
    {
      "src": "dist/server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/server/server.js"
    }
  ],
  "functions": {
    "dist/server/**": {
      "runtime": "nodejs24.x",
      "maxDuration": 30
    }
  }
}
